# Run python3 ops/bootstrap.py to generate .env with unique credentials.
# This is deployment input; do not pass it directly to python -m memu.
# Keep generated password/tokens URL-safe; never commit .env.
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
MEMU_OWNER_TOKEN=GENERATE_OWNER_TOKEN
MEMU_AGENT_TOKEN=GENERATE_AGENT_TOKEN

# External model services. Containers cannot reach host services at 127.0.0.1.
# Docker Desktop / Linux host gateway example; the model must listen on a reachable interface.
MLLM_BASE_URL=http://host.docker.internal:5070/v1
MLLM_MODEL_NAME=your-served-model-name
MLLM_API_KEY=
MLLM_PROTOCOL=llamacpp
MLLM_TIMEOUT_SECONDS=600
EMB_BASE_URL=http://host.docker.internal:5069/v1
EMB_MODEL_NAME=embeddinggemma-2
EMB_MODEL_REVISION=your-immutable-checkpoint-revision
EMB_API_KEY=
EMB_BACKEND=vllm_gemma
MEMU_TIMEZONE=Asia/Shanghai

# Local ports only by default. For remote use, put an authenticated TLS proxy in front.
MEMU_MCP_BIND=127.0.0.1
MEMU_MCP_PORT=5071
MEMU_ACQUISITION_BIND=127.0.0.1
MEMU_ACQUISITION_PORT=5073
MEMU_MCP_ALLOWED_HOSTS='["localhost","127.0.0.1","memu-mcp"]'
MEMU_MCP_ALLOWED_ORIGINS='[]'
MEMU_ACQUISITION_ALLOWED_HOSTS='["localhost","127.0.0.1","memu-acquisition"]'
MEMU_ACQUISITION_ALLOWED_ORIGINS='["http://127.0.0.1:5073","http://localhost:5073"]'
MEMU_MCP_WRITE_ENABLED=true
