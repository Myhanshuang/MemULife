# Docker Compose env_file format: raw. Do NOT wrap JSON in extra shell quotes.
# Copy ONLY the required identity/token pairs from the core's MEMU_MCP_TOKENS.
# The empty mapping deliberately fails validation until configured.
MEMU_MCP_TOKENS={}
MEMU_MCP_IDENTITY=agent1
MEMU_MCP_ALLOWED_ORIGINS=[]
MEMU_MCP_MAX_REQUESTS=16
MEMU_MCP_MAX_BODY_BYTES=16777216
# false hides memory_write and rejects calls before forwarding to the core.
MEMU_MCP_WRITE_ENABLED=true

# Replace with the core host's verified Tailscale IP. This address is a placeholder.
# Tailnet-only TCP 15072 -> core host 127.0.0.1:5072; never use Funnel.
MEMU_CORE_URL=http://100.64.0.10:15072
MEMU_CORE_TIMEOUT_SECONDS=600
