# Copy to .env and fill in the model name and local paths. Do not commit .env.
# Values are parsed as data: $VAR, ${VAR}, backticks and shell commands are NOT expanded.
# Existing process environment variables override this file; CLI flags override both.
# Relative memory/model paths are relative to this file's directory.

# MLLM: llamacpp uses BASE_URL ending in /v1; gateway uses POST /tasks.
MLLM_BASE_URL=http://127.0.0.1:5070/v1
MLLM_API_KEY=
MLLM_MODEL_NAME=your-served-model-name
MLLM_PROTOCOL=llamacpp
MLLM_TIMEOUT_SECONDS=180
MLLM_MAX_OUTPUT_TOKENS=4096
MLLM_REPAIR_ATTEMPTS=2
# Concurrent MLLM tasks across ingestion and views (1-32); restart core to apply.
MLLM_CONCURRENCY=1

# Embedding: vllm_gemma uses an existing EmbeddingGemma 2 vLLM server; no local loading.
# Use an immutable checkpoint revision/hash; update it and rebuild the index when weights change.
# BACKEND=http uses /capabilities + /embed; local_gemma loads MODEL_PATH on CPU.
EMB_BASE_URL=http://127.0.0.1:5069/v1
EMB_API_KEY=
EMB_MODEL_NAME=embeddinggemma-2
EMB_MODEL_REVISION=your-immutable-checkpoint-revision
EMB_BACKEND=vllm_gemma
EMB_MODEL_PATH=
EMB_THREADS=2
# Concurrent embedding calls across ingestion and search (1-32); separate from CPU threads.
# local_gemma serializes its local model internally; HTTP/vLLM allow parallel calls.
EMB_CONCURRENCY=1
EMB_TIMEOUT_SECONDS=120
EMB_IDLE_SECONDS=30

# Storage and deployment. Moving MEMORY_ROOT does not copy existing memory files.
MEMU_MEMORY_ROOT=./memory
# PostgreSQL stores authoritative control state as well as rebuildable indexes.
MEMU_TIMEZONE=Asia/Shanghai
MEMU_DATABASE_URL='postgresql://memu:REPLACE_ME@postgres:5432/memu?connect_timeout=5'
MEMU_MCP_IDENTITY=agent1

# Independent MCP frontend. Bind 0.0.0.0 in containers; list accepted DNS/IP hosts explicitly.
MEMU_MCP_HOST=127.0.0.1
MEMU_MCP_PORT=5071
MEMU_MCP_URL=http://127.0.0.1:5071/mcp
MEMU_MCP_ALLOWED_HOSTS='["127.0.0.1","localhost","memu-mcp"]'
# JSON array of exact browser origins (scheme + hostname/IP + port, no path).
# Example: '["http://0.0.0.0:5070","http://127.0.0.1:5070","http://localhost:5070"]'
# [] disables browser origins. Changes take effect after restarting MCP.
MEMU_MCP_ALLOWED_ORIGINS='[]'
MEMU_MCP_MAX_REQUESTS=16
MEMU_MCP_MAX_BODY_BYTES=16777216
# false hides memory_write and rejects MCP and /v1/memory/write frontend writes.
MEMU_MCP_WRITE_ENABLED=true
# Use different random bearer tokens per identity; keep actual tokens only in .env.
MEMU_MCP_TOKENS='{}'

# Independent core HTTP API. Use http://memu-core:5072 in containers/k3s.
MEMU_CORE_URL=http://127.0.0.1:5072

# Optional migrated source collection UI/service; uses owner identities from the same token map.
MEMU_ACQUISITION_ROOT=./adapter-state
MEMU_ACQUISITION_HOST=127.0.0.1
MEMU_ACQUISITION_PORT=5073
MEMU_ACQUISITION_URL=http://127.0.0.1:5073
MEMU_ACQUISITION_ALLOWED_HOSTS='["localhost","127.0.0.1","memu-acquisition"]'
MEMU_ACQUISITION_ALLOWED_ORIGINS='["http://localhost:5073","http://127.0.0.1:5073"]'
# Independent import jobs may run concurrently; each job keeps its cursor serial.
MEMU_ACQUISITION_WORKERS=2
MEMU_CORE_TIMEOUT_SECONDS=600
MEMU_CORE_HOST=127.0.0.1
MEMU_CORE_PORT=5072
MEMU_CORE_ALLOWED_HOSTS='["127.0.0.1","localhost","memu-core"]'
MEMU_CORE_MAX_REQUESTS=16
# Source files include Base64 originals alongside their extracted content.
MEMU_CORE_MAX_BODY_BYTES=100663296

# Access lists are JSON values. Keep owner in the whitelist with write permission.
MEMU_ACCESS_WHITELIST='{"owner":["read","write"],"agent1":["read","write"]}'
MEMU_ACCESS_OWNERS='["owner"]'

# Event construction. JSON lists must use double quotes for their members.
MEMU_BUILD_DETAIL=detailed
MEMU_BLACKLIST='[]'
MEMU_RELATION_CANDIDATES=12
MEMU_RELATION_LIMIT=4
MEMU_RELATION_VOCAB='["延续","补充","回应","更正","同一事件","因于","相关"]'
MEMU_DIGEST_THRESHOLD_CHARS=12000
MEMU_TASK_BATCH_CHARS=32000
# Unit generation also bounds the number of source/digest records per model call.
MEMU_UNIT_BATCH_ITEMS=8
# Reserved inside TASK_BATCH_CHARS for rolling memory and relevant prior entries.
MEMU_COMPACT_CONTEXT_CHARS=4096
# Defer derived resources during sustained intake with at least this many queued writes.
# Resume after this many seconds without another durable source admission.
MEMU_SOURCE_PRIORITY_BACKLOG=32
MEMU_SOURCE_PRIORITY_QUIET_SECONDS=30

# Views and background maintenance.
MEMU_VIEW_REFRESH_SECONDS=60
MEMU_DAILY_AT=02:10
MEMU_RUNTIME_REBUILD_WEEKDAY=sunday
MEMU_MEMORY_OVERVIEW_CHARS=1200
MEMU_PER_TOPIC_CHARS=400
MEMU_DAY_SUMMARY_CHARS=1600
MEMU_MONTH_SUMMARY_CHARS=800
# Automatic topics need both independent source records and distinct event days.
# Owner-specified topics are tracked immediately, including before matching records exist.
MEMU_TOPIC_MIN_SOURCES=2
MEMU_TOPIC_MIN_DAYS=2

# Read/search budgets.
MEMU_READ_METHOD=grep
MEMU_READ_LIMIT=12
MEMU_READ_BUDGET_CHARS=6000
MEMU_RELATION_HOPS=1
MEMU_RRF_CONSTANT=60
MEMU_TASK_READ_CALLS=4
MEMU_TASK_READ_CHARS=12000

# To select another file, set MEMU_ENV_FILE in the launching process environment.
# Empty API keys mean no Authorization header. Never paste real keys into this example.
